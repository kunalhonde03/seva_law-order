# SurakshaVani Environment Configuration
APP_NAME=SurakshaVani
APP_ENV=dev
DEMO_MODE=true
SECRET_KEY=change-this-to-a-secure-random-secret-key-32bytes

# Database Configuration (PostgreSQL in production, SQLite for immediate zero-dependency local demo)
# DATABASE_URL=postgresql+psycopg://sv_user:sv_password@localhost:5432/surakshavani_db
DATABASE_URL=sqlite+aiosqlite:///./surakshavani.db

# Cryptography & Blind Indexing Keys
HMAC_PEPPER=surakshavani-pepper-for-blind-indexing-2026-secret
FIELD_ENCRYPTION_KEY=7V8x9Z1A2B3C4D5E6F7G8H9I0J1K2L3M4N5O6P7Q8R9=

# ASR & Voice Providers
ASR_PROVIDER=mock          # Options: mock | whisper_local | sarvam
ASR_CONFIDENCE_MIN=0.65

# LLM Providers
LLM_PROVIDER=recorded      # Options: recorded | anthropic
LLM_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=

# Inbound Communication Channels
CHANNEL=web_sim            # Options: web_sim | whatsapp_cloud | telegram
WHATSAPP_VERIFY_TOKEN=sv_verify_token_2026
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Operational Safeguards
GOLDEN_HOUR_MINUTES=60
RATE_LIMIT_MSGS_PER_MIN=20
AUDIO_RETENTION_MINUTES=10
CONSOLE_ORIGIN=http://localhost:8000
